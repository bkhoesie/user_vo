<?xml version="1.0"?>
<psalm
    errorLevel="3"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
    errorBaseline="tests/psalm-baseline.xml"
    phpVersion="8.0"
>
    <projectFiles>
        <directory name="lib" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <extraFiles>
        <directory name="vendor" />
    </extraFiles>
    <issueHandlers>
        <!--
            Deprecated-OCP-method usage is the exact early-warning signal that would have
            flagged the NC33/34 removed-getter bugs (getUserManager(), getAvatarManager(), etc.)
            before those methods were actually removed upstream. Promoted to error level (rather
            than lowering errorLevel overall, which is mostly noise on this codebase - see
            psalm-baseline.xml's history) so new deprecations fail CI going forward; today's 39
            hits (all IConfig::getAppValue/setAppValue/deleteAppValue, deprecated in favor of
            IAppConfig) are baselined, not fixed - migrating them is a separate, larger effort.
        -->
        <DeprecatedMethod errorLevel="error" />
    </issueHandlers>
</psalm>
